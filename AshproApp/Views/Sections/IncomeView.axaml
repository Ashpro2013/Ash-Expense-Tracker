<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AshproApp.ViewModels"
             xmlns:models="using:AshproApp.Models"
             x:CompileBindings="False"
             x:Class="AshproApp.Views.Sections.IncomeView"
             x:DataType="vm:MainWindowViewModel">
  <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
    <Border Classes="surfaceCard">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding IncomeHeader}" Classes="sectionTitle" />
        <TextBlock Text="Title" Classes="fieldLabel" />
        <TextBox Text="{Binding IncomeTitle}" />
        <TextBlock Text="Amount" Classes="fieldLabel" />
        <TextBox Text="{Binding IncomeAmount}" />
        <TextBlock Text="Entry date" Classes="fieldLabel" />
        <DatePicker SelectedDate="{Binding IncomeEntryDate}" />
        <TextBlock Text="Note" Classes="fieldLabel" />
        <TextBox Text="{Binding IncomeNote}" AcceptsReturn="True" Height="90" TextWrapping="Wrap" />
        <TextBlock Text="{Binding IncomeFormError}" Classes="error" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
          <Button Content="Save income" Classes="primaryAction" Command="{Binding SaveIncomeCommand}" />
          <Button Content="Cancel" Command="{Binding CancelIncomeEditCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Classes="surfaceCard">
      <StackPanel>
        <TextBlock Text="Income history" Classes="sectionTitle" />
        <TextBlock Text="{Binding IncomeTotal, StringFormat='Last 30 days total: {0:C}'}" Classes="muted" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding IncomeEntries}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:FinanceEntry">
              <Border Background="#EAF6F5" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding EntryDate, StringFormat='{}{0:MMM dd, yyyy}'}" Classes="muted" />
                  <TextBlock Text="{Binding Amount, StringFormat='{}{0:C}'}" FontWeight="Bold" />
                  <TextBlock Text="{Binding Note}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Edit" Command="{Binding $parent[UserControl].DataContext.EditIncomeCommand}" CommandParameter="{Binding}" />
                    <Button Content="Delete" Command="{Binding $parent[UserControl].DataContext.DeleteIncomeCommand}" CommandParameter="{Binding}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
