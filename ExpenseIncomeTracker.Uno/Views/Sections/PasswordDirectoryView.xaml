<UserControl x:Class="ExpenseIncomeTracker.Uno.Views.Sections.PasswordDirectoryView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             RequestedTheme="Light">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="18" BorderBrush="#BFDBFE" BorderThickness="1">
        <StackPanel Spacing="14">
            <TextBlock Text="Password Directory" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Store account credentials and related notes." Foreground="{StaticResource TextMutedBrush}" />
            <Border Background="#FFFFFFFF" CornerRadius="12" Padding="12" BorderBrush="#BFDBFE" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBox Header="Title" Text="{Binding PasswordTitle, Mode=TwoWay}" />
                    <TextBox Header="Username" Text="{Binding PasswordUsername, Mode=TwoWay}" />
                    <TextBox Header="Password" Text="{Binding PasswordValue, Mode=TwoWay}" />
                    <TextBox Header="Notes" Text="{Binding PasswordNotes, Mode=TwoWay}" />
                    <Button Content="{Binding PasswordSaveButtonText}" Command="{Binding AddPasswordCommand}" />
                </StackPanel>
            </Border>
            <Border Background="#F8FAFC" CornerRadius="12" Padding="8" BorderBrush="#BFDBFE" BorderThickness="1">
                <ListView ItemsSource="{Binding PasswordDirectoryEntries}" MaxHeight="420">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Username}" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding MaskedPassword}" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding Notes}" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                        <Button Content="Edit"
                                                Command="{Binding DataContext.EditPasswordCommand, ElementName=Root}"
                                                CommandParameter="{Binding Id}"
                                                Background="#E0F2FE"
                                                Foreground="#075985"
                                                BorderBrush="#7DD3FC" />
                                        <Button Content="Delete"
                                                Command="{Binding DataContext.DeletePasswordCommand, ElementName=Root}"
                                                CommandParameter="{Binding Id}"
                                                Background="#FEE2E2"
                                                Foreground="#B91C1C"
                                                BorderBrush="#FCA5A5" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
