<UserControl x:Class="ExpenseIncomeTracker.Uno.Views.Sections.ActivityView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             RequestedTheme="Light">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="18" BorderBrush="#A7F3D0" BorderThickness="1">
        <StackPanel Spacing="14">
            <TextBlock Text="Activities" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Plan and complete important activities." Foreground="{StaticResource TextMutedBrush}" />
            <Border Background="#FFFFFFFF" CornerRadius="12" Padding="12" BorderBrush="#A7F3D0" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBox Header="Title" Text="{Binding ActivityTitle, Mode=TwoWay}" />
                    <TextBox Header="Due date (yyyy-MM-dd)" Text="{Binding ActivityDueDate, Mode=TwoWay}" />
                    <ComboBox Header="Status"
                              ItemsSource="{Binding ActivityStatuses}"
                              SelectedItem="{Binding ActivityStatus, Mode=TwoWay}" />
                    <TextBox Header="Notes" Text="{Binding ActivityNote, Mode=TwoWay}" />
                    <CheckBox Content="Important" IsChecked="{Binding ActivityImportant, Mode=TwoWay}" />
                    <Button Content="{Binding ActivitySaveButtonText}" Command="{Binding AddActivityCommand}" />
                </StackPanel>
            </Border>
            <Border Background="#F8FAFC" CornerRadius="12" Padding="8" BorderBrush="#A7F3D0" BorderThickness="1">
                <ListView ItemsSource="{Binding ActivityEntries}" MaxHeight="420">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Content="Edit"
                                                Command="{Binding DataContext.EditActivityCommand, ElementName=Root}"
                                                CommandParameter="{Binding Id}"
                                                Background="#E0F2FE"
                                                Foreground="#075985"
                                                BorderBrush="#7DD3FC" />
                                        <Button Content="Done"
                                                Command="{Binding DataContext.ToggleActivityDoneCommand, ElementName=Root}"
                                                CommandParameter="{Binding Id}"
                                                Background="#DCFCE7"
                                                Foreground="#166534"
                                                BorderBrush="#86EFAC" />
                                        <Button Content="Delete"
                                                Command="{Binding DataContext.DeleteActivityCommand, ElementName=Root}"
                                                CommandParameter="{Binding Id}"
                                                Background="#FEE2E2"
                                                Foreground="#B91C1C"
                                                BorderBrush="#FCA5A5" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
