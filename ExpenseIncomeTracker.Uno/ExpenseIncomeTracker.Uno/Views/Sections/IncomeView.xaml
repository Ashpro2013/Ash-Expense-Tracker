<UserControl x:Class="ExpenseIncomeTracker.Uno.Views.Sections.IncomeView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             RequestedTheme="Light">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="18" BorderBrush="#BAE6FD" BorderThickness="1">
        <StackPanel Spacing="14">
            <TextBlock Text="Income" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Capture salary, freelance, and side income." Foreground="{StaticResource TextMutedBrush}" />
            <Border Background="#FFFFFFFF" CornerRadius="12" Padding="12" BorderBrush="#BAE6FD" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBox Header="Title" Text="{Binding IncomeTitle, Mode=TwoWay}" />
                    <TextBox Header="Amount" Text="{Binding IncomeAmount, Mode=TwoWay}" />
                    <TextBox Header="Note" Text="{Binding IncomeNote, Mode=TwoWay}" />
                    <Button Content="{Binding IncomeSaveButtonText}" Command="{Binding AddIncomeCommand}" />
                </StackPanel>
            </Border>
            <Border Background="#F8FAFC" CornerRadius="12" Padding="8" BorderBrush="#BAE6FD" BorderThickness="1">
                <ListView ItemsSource="{Binding IncomeEntries}" MaxHeight="420">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Note}" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Amount}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" />
                                        <Button Content="Edit"
                                                Command="{Binding DataContext.EditIncomeCommand, ElementName=Root}"
                                                CommandParameter="{Binding Id}"
                                                Background="#E0F2FE"
                                                Foreground="#075985"
                                                BorderBrush="#7DD3FC" />
                                        <Button Content="Delete"
                                                Command="{Binding DataContext.DeleteIncomeCommand, ElementName=Root}"
                                                CommandParameter="{Binding Id}"
                                                Background="#FEE2E2"
                                                Foreground="#B91C1C"
                                                BorderBrush="#FCA5A5" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
