<UserControl x:Class="ExpenseIncomeTracker.Uno.Views.Sections.AlbumView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:ExpenseIncomeTracker.Uno.Models"
             mc:Ignorable="d"
             RequestedTheme="Light">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="18" BorderBrush="#86EFAC" BorderThickness="1">
        <StackPanel Spacing="14">
            <TextBlock Text="Image Album" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Upload from gallery or capture with camera, then browse your album." Foreground="{StaticResource TextMutedBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Upload from Gallery" Click="OnPickFromGalleryClicked" Background="#DCFCE7" Foreground="#166534" BorderBrush="#86EFAC" />
                <Button Content="Take Photo" Click="OnTakePhotoClicked" Background="#E0F2FE" Foreground="#075985" BorderBrush="#7DD3FC" />
            </StackPanel>
            <TextBlock x:Name="AlbumStatusText" x:FieldModifier="public" Visibility="Collapsed" Foreground="#166534" />
            <Border Background="#FFFFFF" CornerRadius="12" Padding="10" BorderBrush="#D1FAE5" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Sliding Viewer" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AlbumPrevButton"
                                x:FieldModifier="public"
                                Content="&lt;"
                                Click="OnShowPreviousAlbumImageClicked"
                                VerticalAlignment="Center"
                                Width="42" />
                        <Grid Grid.Column="1">
                            <FlipView x:Name="AlbumFlipView"
                                      x:FieldModifier="public"
                                      Height="260"
                                      SelectionChanged="OnAlbumFlipViewSelectionChanged">
                                <FlipView.ItemTemplate>
                                    <DataTemplate x:DataType="models:AlbumImageItem">
                                        <Image Source="{x:Bind ImageUri}" Stretch="UniformToFill" />
                                    </DataTemplate>
                                </FlipView.ItemTemplate>
                            </FlipView>
                            <TextBlock x:Name="AlbumSlideEmptyText"
                                       x:FieldModifier="public"
                                       Text="No images yet. Use Upload or Take Photo to add one."
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                        <Button Grid.Column="2"
                                x:Name="AlbumNextButton"
                                x:FieldModifier="public"
                                Content="&gt;"
                                Click="OnShowNextAlbumImageClicked"
                                VerticalAlignment="Center"
                                Width="42" />
                    </Grid>
                    <TextBlock x:Name="AlbumSlideMetaText" x:FieldModifier="public" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>
            <Border Background="#F8FAFC" CornerRadius="12" Padding="8" BorderBrush="#86EFAC" BorderThickness="1">
                <ListView x:Name="AlbumListView" x:FieldModifier="public" MaxHeight="320">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AlbumImageItem">
                            <Border Background="#FFFFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="72" Height="72" CornerRadius="8" Background="#E2E8F0">
                                        <Image Source="{x:Bind ImageUri}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind OriginalName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind SourceType}" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{x:Bind AddedOn}" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Delete" Tag="{x:Bind Id}" Click="OnDeleteAlbumImageClicked" Background="#FEE2E2" Foreground="#B91C1C" BorderBrush="#FCA5A5" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
