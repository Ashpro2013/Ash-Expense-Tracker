<UserControl x:Class="ExpenseIncomeTracker.Uno.Views.Sections.AlbumView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             RequestedTheme="Light">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="18" BorderBrush="#86EFAC" BorderThickness="1">
        <StackPanel Spacing="14">
            <TextBlock Text="Image Album" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Upload from gallery or capture with camera, then browse your album." Foreground="{StaticResource TextMutedBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Upload from Gallery" Command="{Binding PickFromGalleryCommand}" Background="#DCFCE7" Foreground="#166534" BorderBrush="#86EFAC" />
                <Button Content="Take Photo" Command="{Binding TakePhotoCommand}" Background="#E0F2FE" Foreground="#075985" BorderBrush="#7DD3FC" />
            </StackPanel>
            <TextBlock Text="{Binding AlbumStatusText}"
                       Visibility="{Binding AlbumStatusVisibility}"
                       Foreground="{Binding AlbumStatusBrush}" />
            <Border Background="#FFFFFF" CornerRadius="12" Padding="10" BorderBrush="#D1FAE5" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="Sliding Viewer" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="&lt;"
                                Command="{Binding ShowPreviousAlbumImageCommand}"
                                IsEnabled="{Binding AlbumCanSlide}"
                                VerticalAlignment="Center"
                                Width="42" />
                        <Grid Grid.Column="1">
                            <FlipView ItemsSource="{Binding AlbumEntries}"
                                      Height="260"
                                      Visibility="{Binding AlbumFlipVisibility}"
                                      SelectedIndex="{Binding SelectedAlbumIndex, Mode=TwoWay}">
                                <FlipView.ItemTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding ImageUri}" Stretch="UniformToFill" />
                                    </DataTemplate>
                                </FlipView.ItemTemplate>
                            </FlipView>
                            <TextBlock Text="No images yet. Use Upload or Take Photo to add one."
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Visibility="{Binding AlbumSlideEmptyVisibility}" />
                        </Grid>
                        <Button Grid.Column="2"
                                Content=">"
                                Command="{Binding ShowNextAlbumImageCommand}"
                                IsEnabled="{Binding AlbumCanSlide}"
                                VerticalAlignment="Center"
                                Width="42" />
                    </Grid>
                    <TextBlock Text="{Binding AlbumSlideMetaText}" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>
            <Border Background="#F8FAFC" CornerRadius="12" Padding="8" BorderBrush="#86EFAC" BorderThickness="1">
                <ListView ItemsSource="{Binding AlbumEntries}" MaxHeight="320">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="72" Height="72" CornerRadius="8" Background="#E2E8F0">
                                        <Image Source="{Binding ImageUri}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OriginalName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SourceType}" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding AddedOn}" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Delete"
                                            Command="{Binding DataContext.DeleteAlbumImageCommand, ElementName=Root}"
                                            CommandParameter="{Binding Id}"
                                            Background="#FEE2E2"
                                            Foreground="#B91C1C"
                                            BorderBrush="#FCA5A5"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
