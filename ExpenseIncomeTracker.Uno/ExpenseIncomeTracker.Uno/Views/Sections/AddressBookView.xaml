<UserControl x:Class="ExpenseIncomeTracker.Uno.Views.Sections.AddressBookView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             RequestedTheme="Light">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="18" BorderBrush="#FDE68A" BorderThickness="1">
        <StackPanel Spacing="14">
            <TextBlock Text="Address Book" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Manage contacts with full details." Foreground="{StaticResource TextMutedBrush}" />
            <Border Background="#FFFFFFFF" CornerRadius="12" Padding="12" BorderBrush="#FDE68A" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBox Header="Name" Text="{Binding AddressName, Mode=TwoWay}" />
                    <TextBox Header="Address" Text="{Binding AddressAddress, Mode=TwoWay}" />
                    <TextBox Header="Phone no" Text="{Binding AddressPhoneNo, Mode=TwoWay}" />
                    <TextBox Header="Email" Text="{Binding AddressEmail, Mode=TwoWay}" />
                    <TextBox Header="Remarks" Text="{Binding AddressRemarks, Mode=TwoWay}" />
                    <Button Content="{Binding AddressSaveButtonText}" Command="{Binding AddAddressCommand}" />
                </StackPanel>
            </Border>
            <Border Background="#F8FAFC" CornerRadius="12" Padding="8" BorderBrush="#FDE68A" BorderThickness="1">
                <ListView ItemsSource="{Binding AddressBookEntries}" MaxHeight="420">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Address}" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding PhoneNo}" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding Email}" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding Remarks}" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                        <Button Content="Edit"
                                                Command="{Binding DataContext.EditAddressCommand, ElementName=Root}"
                                                CommandParameter="{Binding Id}"
                                                Background="#E0F2FE"
                                                Foreground="#075985"
                                                BorderBrush="#7DD3FC" />
                                        <Button Content="Delete"
                                                Command="{Binding DataContext.DeleteAddressCommand, ElementName=Root}"
                                                CommandParameter="{Binding Id}"
                                                Background="#FEE2E2"
                                                Foreground="#B91C1C"
                                                BorderBrush="#FCA5A5" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
