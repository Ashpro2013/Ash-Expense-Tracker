<UserControl x:Class="ExpenseIncomeTracker.Uno.Views.Sections.DiaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:ExpenseIncomeTracker.Uno.Models"
             mc:Ignorable="d"
             RequestedTheme="Light">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="18" BorderBrush="#C4B5FD" BorderThickness="1">
        <StackPanel Spacing="14">
            <TextBlock Text="Diary" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Journal the day, mood, and reflections." Foreground="{StaticResource TextMutedBrush}" />
            <Border Background="#FFFFFFFF" CornerRadius="12" Padding="12" BorderBrush="#C4B5FD" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBox x:Name="DiaryTitleBox" x:FieldModifier="public" Header="Title" />
                    <TextBox x:Name="DiaryContentBox" x:FieldModifier="public" Header="Content" AcceptsReturn="True" TextWrapping="Wrap" />
                    <TextBox x:Name="DiaryTagsBox" x:FieldModifier="public" Header="Tags (comma separated)" />
                    <TextBox x:Name="DiaryMoodBox" x:FieldModifier="public" Header="Mood (1-5)" />
                    <Button x:Name="DiarySaveButton" x:FieldModifier="public" Content="Add Diary Entry" Click="OnAddDiaryClicked" />
                </StackPanel>
            </Border>
            <Border Background="#F8FAFC" CornerRadius="12" Padding="8" BorderBrush="#DDD6FE" BorderThickness="1">
                <ListView x:Name="DiaryListView" x:FieldModifier="public" MaxHeight="420">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:DiaryEntry">
                            <Border Background="#FFFFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Tags}" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Mood}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" />
                                        <Button Content="Edit" Tag="{x:Bind Id}" Click="OnEditDiaryClicked" Background="#E0F2FE" Foreground="#075985" BorderBrush="#7DD3FC" />
                                        <Button Content="Delete" Tag="{x:Bind Id}" Click="OnDeleteDiaryClicked" Background="#FEE2E2" Foreground="#B91C1C" BorderBrush="#FCA5A5" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
