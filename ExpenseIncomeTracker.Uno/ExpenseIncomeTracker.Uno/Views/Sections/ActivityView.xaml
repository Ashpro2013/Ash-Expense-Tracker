<UserControl x:Class="ExpenseIncomeTracker.Uno.Views.Sections.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:ExpenseIncomeTracker.Uno.Models"
             mc:Ignorable="d"
             RequestedTheme="Light">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="18" BorderBrush="#A7F3D0" BorderThickness="1">
        <StackPanel Spacing="14">
            <TextBlock Text="Activities" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Plan and complete important activities." Foreground="{StaticResource TextMutedBrush}" />
            <Border Background="#FFFFFFFF" CornerRadius="12" Padding="12" BorderBrush="#A7F3D0" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBox x:Name="ActivityTitleBox" x:FieldModifier="public" Header="Title" />
                    <TextBox x:Name="ActivityDueDateBox" x:FieldModifier="public" Header="Due date (yyyy-MM-dd)" />
                    <ComboBox x:Name="ActivityStatusBox" x:FieldModifier="public" Header="Status" SelectedIndex="0">
                        <ComboBoxItem Content="Planned" />
                        <ComboBoxItem Content="InProgress" />
                        <ComboBoxItem Content="Done" />
                    </ComboBox>
                    <TextBox x:Name="ActivityNoteBox" x:FieldModifier="public" Header="Notes" />
                    <CheckBox x:Name="ActivityImportantBox" x:FieldModifier="public" Content="Important" />
                    <Button x:Name="ActivitySaveButton" x:FieldModifier="public" Content="Add Activity" Click="OnAddActivityClicked" />
                </StackPanel>
            </Border>
            <Border Background="#F8FAFC" CornerRadius="12" Padding="8" BorderBrush="#A7F3D0" BorderThickness="1">
                <ListView x:Name="ActivityListView" x:FieldModifier="public" MaxHeight="420">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ActivityItem">
                            <Border Background="#FFFFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Description}" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Status}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Content="Edit" Tag="{x:Bind Id}" Click="OnEditActivityClicked" Background="#E0F2FE" Foreground="#075985" BorderBrush="#7DD3FC" />
                                        <Button Content="Done" Tag="{x:Bind Id}" Click="OnToggleActivityDoneClicked" Background="#DCFCE7" Foreground="#166534" BorderBrush="#86EFAC" />
                                        <Button Content="Delete" Tag="{x:Bind Id}" Click="OnDeleteActivityClicked" Background="#FEE2E2" Foreground="#B91C1C" BorderBrush="#FCA5A5" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
