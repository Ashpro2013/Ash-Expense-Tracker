<UserControl x:Class="ExpenseIncomeTracker.Uno.Views.Sections.PlanView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             RequestedTheme="Light">
    <Border Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="18" BorderBrush="#FED7AA" BorderThickness="1">
        <StackPanel Spacing="14">
            <TextBlock Text="Plan a Day" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Allocate focused time slots and track completion." Foreground="{StaticResource TextMutedBrush}" />
            <Border Background="#FFFFFFFF" CornerRadius="12" Padding="12" BorderBrush="#FED7AA" BorderThickness="1">
                <StackPanel Spacing="10">
                    <DatePicker Header="Date (yyyy-MM-dd)" Date="{Binding PlanDate, Mode=TwoWay}" />
                    <TextBox Header="Task title" Text="{Binding PlanTitle, Mode=TwoWay}" />
                    <TimePicker Header="Start time (HH:mm)" ClockIdentifier="24HourClock" Time="{Binding PlanStartTime, Mode=TwoWay}" />
                    <TimePicker Header="End time (HH:mm)" ClockIdentifier="24HourClock" Time="{Binding PlanEndTime, Mode=TwoWay}" />
                    <TextBox Header="Notes" Text="{Binding PlanNotes, Mode=TwoWay}" />
                    <Button Content="{Binding PlanSaveButtonText}" Command="{Binding AddPlanCommand}" />
                </StackPanel>
            </Border>
            <Border Background="#F8FAFC" CornerRadius="12" Padding="8" BorderBrush="#FED7AA" BorderThickness="1">
                <ListView ItemsSource="{Binding PlanEntries}" MaxHeight="420">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFFFF" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Notes}" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding StartTime}" VerticalAlignment="Center" />
                                        <TextBlock Text="-" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding EndTime}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Content="Edit"
                                                Command="{Binding DataContext.EditPlanCommand, ElementName=Root}"
                                                CommandParameter="{Binding Id}"
                                                Background="#E0F2FE"
                                                Foreground="#075985"
                                                BorderBrush="#7DD3FC" />
                                        <Button Content="Done"
                                                Command="{Binding DataContext.TogglePlanCommand, ElementName=Root}"
                                                CommandParameter="{Binding Id}"
                                                Background="#DCFCE7"
                                                Foreground="#166534"
                                                BorderBrush="#86EFAC" />
                                        <Button Content="Delete"
                                                Command="{Binding DataContext.DeletePlanCommand, ElementName=Root}"
                                                CommandParameter="{Binding Id}"
                                                Background="#FEE2E2"
                                                Foreground="#B91C1C"
                                                BorderBrush="#FCA5A5" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
