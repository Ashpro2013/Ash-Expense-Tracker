<Page x:Class="ExpenseIncomeTracker.Uno.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:nav="using:ExpenseIncomeTracker.Uno.Views.Navigation"
      xmlns:sections="using:ExpenseIncomeTracker.Uno.Views.Sections"
      mc:Ignorable="d"
      RequestedTheme="Light">
    <Page.Resources>
        <Color x:Key="BrandTeal">#0F766E</Color>
        <Color x:Key="BrandAqua">#14B8A6</Color>
        <Color x:Key="AccentGold">#F59E0B</Color>
        <Color x:Key="TextMain">#0F172A</Color>
        <Color x:Key="TextMuted">#64748B</Color>
        <SolidColorBrush x:Key="BrandTealBrush" Color="{StaticResource BrandTeal}" />
        <SolidColorBrush x:Key="BrandAquaBrush" Color="{StaticResource BrandAqua}" />
        <SolidColorBrush x:Key="AccentGoldBrush" Color="{StaticResource AccentGold}" />
        <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource TextMain}" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}" />
        <SolidColorBrush x:Key="PanelBrush" Color="#F7FFFFFF" />
        <SolidColorBrush x:Key="NavSelectedBackgroundBrush" Color="#CCFBF1" />
        <SolidColorBrush x:Key="NavPointerBackgroundBrush" Color="#ECFEFF" />
        <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FEF3C7" Offset="0" />
            <GradientStop Color="#F8FAFC" Offset="0.45" />
            <GradientStop Color="#ECFEFF" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#0F172A" />
        <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#0F172A" />
        <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#0F172A" />
        <SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="#0F172A" />
        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#CCFBF1" />
        <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#99F6E4" />
        <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#ECFEFF" />
        <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{StaticResource BrandTeal}" />
        <SolidColorBrush x:Key="TextControlHeaderForeground" Color="#0F172A" />
        <SolidColorBrush x:Key="TextControlHeaderForegroundFocused" Color="#0F172A" />
        <SolidColorBrush x:Key="TextControlHeaderForegroundPointerOver" Color="#0F172A" />
        <SolidColorBrush x:Key="TextControlForeground" Color="#0F172A" />
        <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#64748B" />
        <SolidColorBrush x:Key="ComboBoxForeground" Color="#0F172A" />
        <SolidColorBrush x:Key="ComboBoxHeaderForeground" Color="#0F172A" />
        <SolidColorBrush x:Key="ComboBoxHeaderForegroundFocused" Color="#0F172A" />
        <SolidColorBrush x:Key="ComboBoxHeaderForegroundPointerOver" Color="#0F172A" />
        <DataTemplate x:Key="DarkHeaderTemplate">
            <TextBlock Text="{Binding}" Foreground="#0F172A" FontWeight="SemiBold" />
        </DataTemplate>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>
        <Style TargetType="NavigationViewItem">
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HeaderTemplate" Value="{StaticResource DarkHeaderTemplate}" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HeaderTemplate" Value="{StaticResource DarkHeaderTemplate}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HeaderTemplate" Value="{StaticResource DarkHeaderTemplate}" />
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HeaderTemplate" Value="{StaticResource DarkHeaderTemplate}" />
        </Style>
        <Style TargetType="TimePicker">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HeaderTemplate" Value="{StaticResource DarkHeaderTemplate}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Background" Value="{StaticResource BrandTealBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandTealBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid x:Name="AuthRoot" Padding="24" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="#C7D2FE" BorderThickness="1" CornerRadius="22" Padding="22">
                <StackPanel Spacing="12">
                    <TextBlock Text="CashTrack Pro" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" />
                    <TextBlock Text="Finance, diary, activities, and day planning in one place." Foreground="{StaticResource TextMutedBrush}" />

                    <TextBlock x:Name="AuthModeText" Text="Sign In" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0" Foreground="{StaticResource TextMainBrush}" />
                    <TextBox x:Name="AuthEmailBox"
                             Header="Email"
                             PlaceholderText="you@example.com"
                             Margin="0,2,0,0" />
                    <PasswordBox x:Name="AuthPasswordBox"
                                 Header="Password"
                                 PlaceholderText="Enter password"
                                 Margin="0,2,0,0" />
                    <PasswordBox x:Name="AuthConfirmPasswordBox"
                                 Header="Confirm Password"
                                 PlaceholderText="Re-enter password"
                                 Visibility="Collapsed"
                                 Margin="0,2,0,0" />
                    <TextBlock x:Name="AuthErrorText" Foreground="#B91C1C" Visibility="Collapsed" TextWrapping="Wrap" />

                    <Button x:Name="AuthSubmitButton"
                            Content="Sign In"
                            Click="AuthSubmitClicked"
                            Background="{StaticResource BrandTealBrush}"
                            Foreground="White" />
                    <Button x:Name="AuthSwitchButton"
                            Content="Create account"
                            Click="AuthSwitchClicked"
                            Background="#F3F4F6"
                            Foreground="{StaticResource BrandTealBrush}"
                            BorderBrush="#CBD5E1"
                            Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="AppRoot" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Margin="14,12,14,6" Padding="16,12" Background="{StaticResource PanelBrush}" BorderBrush="#D1FAE5" BorderThickness="1" CornerRadius="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="CashTrack Pro" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextMainBrush}" />
                        <TextBlock Text="Smart personal finance and productivity companion" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock x:Name="WelcomeText" Foreground="{StaticResource BrandTealBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Sign Out"
                            Click="SignOutClicked"
                            VerticalAlignment="Center"
                            Background="#FFF1F2"
                            Foreground="#BE123C"
                            BorderBrush="#FDA4AF" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <nav:SideNavigationControl x:Name="SideNavigation" Grid.Column="0" />

                <ScrollViewer Grid.Column="1">
                    <StackPanel Spacing="16" Padding="18,14,18,20">
                        <sections:DashboardView x:Name="DashboardSection" />
                        <sections:IncomeView x:Name="IncomeSection" Visibility="Collapsed" />
                        <sections:ExpenseView x:Name="ExpenseSection" Visibility="Collapsed" />
                        <sections:ActivityView x:Name="ActivitySection" Visibility="Collapsed" />
                        <sections:DiaryView x:Name="DiarySection" Visibility="Collapsed" />
                        <sections:PlanView x:Name="PlanSection" Visibility="Collapsed" />
                        <sections:AlbumView x:Name="AlbumSection" Visibility="Collapsed" />
                        <sections:AddressBookView x:Name="AddressBookSection" Visibility="Collapsed" />
                        <sections:PasswordDirectoryView x:Name="PasswordDirectorySection" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
