@inherits LayoutComponentBase

<div class="auth-shell">
    <section class="auth-hero">
        <div class="auth-hero-content">
            <h1 class="hero-title">Reflect daily. Move intentionally.</h1>
            <p class="hero-subtitle">
                A calm space to capture memories and keep your next actions visible.
            </p>
            <div class="hero-badges">
                <span class="hero-pill">Daily reflections</span>
                <span class="hero-pill">Focused activity plans</span>
                <span class="hero-pill">Private by design</span>
            </div>
        </div>
    </section>
    <section class="auth-panel">
        <FluentCard class="auth-card">
            @Body
        </FluentCard>
    </section>
</div>
