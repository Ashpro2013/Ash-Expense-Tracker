@inherits LayoutComponentBase
@inject NavigationManager Navigation

<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />

<div class="app-shell">
    <header class="app-header">
        <div class="header-left">
            <div class="logo-mark">EI</div>
            <div>
                <div class="app-title">Finance, Diary &amp; Activity Manager</div>
                <div class="app-subtitle">Track cash flow and daily progress in one workspace.</div>
            </div>
        </div>
        <div class="header-actions">
            <AuthorizeView>
                <Authorized>
                    <div class="user-chip">@context.User.Identity?.Name</div>
                    <form method="post" action="/account/logout" @formname="logout" style="display: inline;">
                        <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent">Sign out</FluentButton>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <FluentButton Appearance="Appearance.Accent" OnClick="@(() => Navigation.NavigateTo("/login"))">Sign in</FluentButton>
                    <FluentButton Appearance="Appearance.Outline" OnClick="@(() => Navigation.NavigateTo("/register"))">Sign up</FluentButton>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <div class="app-body">
        <aside class="side-rail">
            <NavMenu />
        </aside>
        <main class="main-content">
            @Body
        </main>
    </div>
</div>
