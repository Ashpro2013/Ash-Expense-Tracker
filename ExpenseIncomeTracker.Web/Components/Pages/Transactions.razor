@page "/activities"
@attribute [Authorize]

<PageTitle>Activity Monitoring</PageTitle>

<div class="page-head">
    <div>
        <FluentLabel Typo="Typography.PageTitle">Activity Monitoring</FluentLabel>
        <p class="page-subtitle">Monitor planned work, in-progress items, and completions.</p>
    </div>
    <div class="page-actions">
        <FluentButton Appearance="Appearance.Accent" OnClick="NewActivity">New activity</FluentButton>
    </div>
</div>

<div class="two-column">
    <FluentCard class="panel-card">
        <div class="panel-header">
            <FluentLabel Typo="Typography.H5">@(_editingId is null ? "Plan activity" : "Edit activity")</FluentLabel>
        </div>
        <EditForm Model="_form" OnValidSubmit="SaveActivity">
            <DataAnnotationsValidator />
            <div class="form-stack">
                <FluentTextField Label="Title" Required="true" @bind-Value="_form.Title" />
                <FluentTextField Label="Category" @bind-Value="_form.Category" />
                <FluentSelect Label="Status" Items="ActivityStatuses" @bind-SelectedOption="_form.Status" />
                <FluentDatePicker Label="Start date" @bind-Value="_form.StartDate" />
                <FluentDatePicker Label="Due date" @bind-Value="_form.DueDate" />
                <FluentTextArea Label="Notes" Rows="4" @bind-Value="_form.Description" />
                <FluentCheckbox Label="Mark as important" @bind-Value="_form.IsImportant" />

                @if (!string.IsNullOrWhiteSpace(_formError))
                {
                    <div class="form-error">@_formError</div>
                }

                <div class="form-actions">
                    <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Submit" Loading="_saving">Save activity</FluentButton>
                    @if (_editingId is not null)
                    {
                        <FluentButton Appearance="Appearance.Outline" OnClick="ResetForm">Cancel</FluentButton>
                    }
                </div>
            </div>
        </EditForm>
    </FluentCard>

    <FluentCard class="panel-card">
        <div class="panel-header">
            <FluentLabel Typo="Typography.H5">Activity list</FluentLabel>
            <FluentSelect Label="Filter" Items="StatusFilters" @bind-SelectedOption="_statusFilter" />
        </div>
        <div class="list-stack">
            @if (FilteredActivities.Count == 0)
            {
                <p class="empty-state">No activities match this filter.</p>
            }
            else
            {
                @foreach (var activity in FilteredActivities)
                {
                    <div class="entry-card">
                        <div class="entry-info">
                            <div class="item-title">
                                @activity.Title
                                @if (activity.IsImportant)
                                {
                                    <span class="tag">Important</span>
                                }
                            </div>
                            <div class="item-meta">@FormatSchedule(activity)</div>
                            <div class="item-meta">@(!string.IsNullOrWhiteSpace(activity.Description) ? activity.Description : "No notes yet.")</div>
                        </div>
                        <div class="entry-actions">
                            <span class="status-pill status-@activity.Status.ToString().ToLowerInvariant()">@activity.Status</span>
                            <div class="button-row">
                                <FluentButton Appearance="Appearance.Outline" OnClick="@(() => StartEdit(activity))">Edit</FluentButton>
                                <FluentButton Appearance="Appearance.Outline" OnClick="@(() => ToggleDone(activity))">
                                    @(activity.Status == ActivityStatus.Done ? "Reopen" : "Mark done")
                                </FluentButton>
                                <FluentButton Appearance="Appearance.Outline" OnClick="@(() => DeleteActivity(activity))">Delete</FluentButton>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </FluentCard>
</div>

@code {
    [Inject] private ActivityService ActivityService { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthenticationStateProvider { get; set; } = default!;

    private string _userId = string.Empty;
    private readonly List<ActivityItem> _activities = new();
    private string? _editingId;
    private DateTime? _editingCreatedAt;
    private bool _saving;
    private string? _formError;
    private string _statusFilter = "All";
    private ActivityForm _form = new();

    private static IEnumerable<ActivityStatus> ActivityStatuses => Enum.GetValues<ActivityStatus>();
    private static IEnumerable<string> StatusFilters => new[] { "All", "Planned", "InProgress", "Done" };

    protected override async Task OnInitializedAsync()
    {
        _userId = await GetUserIdAsync();
        await LoadActivities();
    }

    private async Task LoadActivities()
    {
        _activities.Clear();
        if (string.IsNullOrWhiteSpace(_userId))
        {
            return;
        }

        _activities.AddRange(await ActivityService.GetAllAsync(_userId));
    }

    private List<ActivityItem> FilteredActivities
        => _activities
            .Where(activity => _statusFilter == "All" || activity.Status.ToString() == _statusFilter)
            .OrderBy(activity => activity.Status)
            .ThenBy(activity => activity.DueDate ?? DateTime.MaxValue)
            .ToList();

    private void NewActivity()
    {
        ResetForm();
    }

    private void StartEdit(ActivityItem activity)
    {
        _editingId = activity.Id;
        _editingCreatedAt = activity.CreatedAt;
        _form = new ActivityForm
        {
            Title = activity.Title,
            Description = activity.Description,
            Category = activity.Category,
            Status = activity.Status,
            StartDate = activity.StartDate,
            DueDate = activity.DueDate,
            IsImportant = activity.IsImportant
        };
    }

    private async Task SaveActivity()
    {
        if (string.IsNullOrWhiteSpace(_userId))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_form.Title))
        {
            _formError = "Title is required.";
            return;
        }

        _formError = null;
        _saving = true;

        var activity = new ActivityItem
        {
            Id = _editingId,
            UserId = _userId,
            Title = _form.Title.Trim(),
            Description = _form.Description?.Trim(),
            Category = _form.Category?.Trim(),
            Status = _form.Status,
            StartDate = _form.StartDate,
            DueDate = _form.DueDate,
            IsImportant = _form.IsImportant,
            CompletedAt = _form.Status == ActivityStatus.Done ? DateTime.UtcNow : null,
            CreatedAt = _editingCreatedAt ?? DateTime.UtcNow
        };

        if (_editingId is null)
        {
            await ActivityService.CreateAsync(activity);
        }
        else
        {
            await ActivityService.UpdateAsync(activity);
        }

        await LoadActivities();
        ResetForm();
        _saving = false;
    }

    private async Task ToggleDone(ActivityItem activity)
    {
        activity.Status = activity.Status == ActivityStatus.Done ? ActivityStatus.InProgress : ActivityStatus.Done;
        activity.CompletedAt = activity.Status == ActivityStatus.Done ? DateTime.UtcNow : null;
        await ActivityService.UpdateAsync(activity);
        await LoadActivities();
    }

    private async Task DeleteActivity(ActivityItem activity)
    {
        if (string.IsNullOrWhiteSpace(activity.Id))
        {
            return;
        }

        await ActivityService.DeleteAsync(activity.Id, _userId);
        await LoadActivities();
        ResetForm();
    }

    private void ResetForm()
    {
        _editingId = null;
        _editingCreatedAt = null;
        _form = new ActivityForm();
        _formError = null;
    }

    private string FormatSchedule(ActivityItem activity)
    {
        var start = activity.StartDate?.ToLocalTime().ToString("MMM dd") ?? "Flexible";
        var due = activity.DueDate?.ToLocalTime().ToString("MMM dd") ?? "No due date";
        var category = string.IsNullOrWhiteSpace(activity.Category) ? "General" : activity.Category;
        return $"{category} · {start} → {due}";
    }

    private async Task<string> GetUserIdAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;
    }

    private sealed class ActivityForm
    {
        [Required]
        public string Title { get; set; } = string.Empty;

        public string? Description { get; set; }

        public string? Category { get; set; }

        public DateTime? StartDate { get; set; } = DateTime.Today;

        public DateTime? DueDate { get; set; } = DateTime.Today.AddDays(1);

        public ActivityStatus Status { get; set; } = ActivityStatus.Planned;

        public bool IsImportant { get; set; }
    }
}
